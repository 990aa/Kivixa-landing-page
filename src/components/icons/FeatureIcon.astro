---
import type { FeatureIcon } from "@/lib/content";

interface Props {
  kind: FeatureIcon;
  class?: string;
}

const { kind, class: className = "w-5 h-5" } = Astro.props;
---

{kind === "brain" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-2 2.84A3 3 0 0 0 6 14v1a3 3 0 0 0 3 3h1" />
    <path d="M15 4a3 3 0 0 1 3 3v1a3 3 0 0 1 2 2.84A3 3 0 0 1 18 14v1a3 3 0 0 1-3 3h-1" />
    <path d="M12 4v16M9 8h3M12 12h3" />
  </svg>
)}
{kind === "audio" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class={className} aria-hidden="true">
    <path d="M4 12h2m3-4v8m4-11v14m4-10v6m3-3h-2" />
  </svg>
)}
{kind === "notes" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="4" y="3.5" width="16" height="17" rx="2" />
    <path d="M8 8h8M8 12h8M8 16h5" />
  </svg>
)}
{kind === "graph" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class={className} aria-hidden="true">
    <circle cx="6" cy="6" r="2" />
    <circle cx="18" cy="7" r="2" />
    <circle cx="12" cy="18" r="2" />
    <path d="M8 7.2l8 1.6M7.4 7.7l3.8 8.5M16.8 8.6l-3.6 7.3" />
  </svg>
)}
{kind === "timer" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class={className} aria-hidden="true">
    <circle cx="12" cy="13" r="7" />
    <path d="M12 13V9m0-6h-3m3 0h3" />
  </svg>
)}
{kind === "terminal" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M7 10l3 2-3 2m5 0h4" />
  </svg>
)}