---
import { navLinks, REPO_URL } from "@/lib/content";
import IconGitHub from "@/components/icons/IconGitHub.astro";
import MobileMenu from "@/components/ui/MobileMenu.tsx";
---

<header
  class="sticky top-0 z-40 border-b border-transparent backdrop-blur-md transition-colors"
  data-header
>
  <div class="container-page flex h-14 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-fg hover:text-fg">
      <img
        src="/assets/icon.svg"
        alt="Kivixa logo"
        width="24"
        height="24"
        class="h-6 w-6 rounded"
      />
      <span>Kivixa</span>
      <span class="pill pill-accent ml-1 hidden sm:inline-flex">Beta</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-1.5 text-sm text-fg-muted hover:bg-bg-soft hover:text-fg"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost hidden sm:inline-flex"
        aria-label="Kivixa on GitHub"
      >
        <IconGitHub class="w-4 h-4" />
        <span>GitHub</span>
      </a>
      <a href="#download" class="btn-primary hidden sm:inline-flex">Download</a>
      <MobileMenu client:load links={navLinks} />
    </div>
  </div>
</header>

<script>
  // Toggle border visibility on scroll
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 4) {
        header.classList.add("border-border", "bg-bg/70");
        header.classList.remove("border-transparent");
      } else {
        header.classList.remove("border-border", "bg-bg/70");
        header.classList.add("border-transparent");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>