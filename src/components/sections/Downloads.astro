---
import type { ReleaseData } from "@/lib/github";
import { platforms, WINGET_COMMAND, FDROID_REPO_URL, FDROID_QR_URL } from "@/lib/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import IconPlatform from "@/components/icons/IconPlatform.astro";
import CopyButton from "@/components/ui/CopyButton.tsx";
import FDroidSteps from "@/components/ui/FDroidSteps.tsx";

interface Props {
  release: ReleaseData;
}

const { release } = Astro.props;
---

<section
  id="download"
  data-testid="download-section"
  class="section"
>
  <div class="container-page">
    <SectionHeading
      align="center"
      overline="Download"
      heading="Same privacy model, every platform."
      testid="download-heading"
    >
      <Fragment slot="body">
        v{release.version} · built for your device. Pick yours.
      </Fragment>
    </SectionHeading>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        platforms.map((platform, i) => {
          const downloadUrl = release[platform.primaryDownload.releaseKey] ?? release.releasesPageUrl;
          return (
            <li
              class="card card-hover reveal flex flex-col p-6"
              style={`transition-delay: ${i * 60}ms;`}
            >
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-fg">
                    <IconPlatform platform={platform.id} class="w-4 h-4" />
                  </span>
                  <h3 class="text-base font-semibold text-fg">{platform.title}</h3>
                </div>
                <span
                  class:list={[
                    "pill",
                    platform.status === "stable" ? "pill-success" : "",
                  ]}
                >
                  {platform.statusLabel}
                </span>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{platform.blurb}</p>

              <div class="mt-5 flex flex-col gap-3">
                <a
                  href={downloadUrl}
                  data-testid={`download-${platform.id}-primary`}
                  class="btn-primary w-full"
                >
                  {platform.primaryDownload.label}
                </a>

                {platform.secondary?.kind === "winget" && (
                  <div class="flex items-center justify-between gap-2 rounded-lg border border-border bg-bg px-3 py-2">
                    <code class="truncate font-mono text-xs text-fg">{WINGET_COMMAND}</code>
                    <CopyButton client:load value={WINGET_COMMAND} label="Copy" />
                  </div>
                )}

                {platform.secondary?.kind === "fdroid" && (
                  <FDroidSteps client:load repoUrl={FDROID_REPO_URL} qrUrl={FDROID_QR_URL} />
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="reveal mt-10 text-center text-sm text-fg-muted">
      Looking for the .msix package, ARMv7 or x86_64 Android builds?
      <a
        href={release.releasesPageUrl}
        class="text-fg underline decoration-border-hi underline-offset-4 hover:decoration-accent"
      >
        See all release assets
      </a>
      .
    </p>
  </div>
</section>