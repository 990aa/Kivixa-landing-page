---
import { faqs } from "@/lib/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Disclosure from "@/components/ui/Disclosure.tsx";
---

<section id="faq" data-testid="faq-section" class="section">
  <div class="container-page">
    <SectionHeading
      align="center"
      overline="Questions"
      heading="Frequently asked."
      body="If you don't see your question here, open an issue on GitHub."
    />

    <div class="reveal mx-auto mt-12 max-w-3xl card p-6 sm:p-8">
      {
        faqs.map((faq) => (
          <Disclosure client:visible question={faq.q} answer={faq.a} />
        ))
      }
    </div>
  </div>
</section>