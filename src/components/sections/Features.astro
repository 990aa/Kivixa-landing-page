---
import { features } from "@/lib/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import FeatureIcon from "@/components/icons/FeatureIcon.astro";
---

<section id="features" data-testid="features-section" class="section">
  <div class="container-page">
    <SectionHeading
      align="center"
      overline="Everything local"
      heading="One workspace. The full toolkit."
      body="Notes, sketches, planning, AI, timers, scripting — all in a single app that respects your machine and your privacy."
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((card, i) => (
          <li
            class="card card-hover reveal p-6"
            style={`transition-delay: ${i * 60}ms;`}
          >
            <div class="flex items-start justify-between gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-bg-elev text-fg">
                <FeatureIcon kind={card.icon} class="h-5 w-5" />
              </span>
              <span class="pill pill-accent">{card.tag}</span>
            </div>
            <h3 class="mt-5 text-lg font-semibold tracking-tight text-fg">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{card.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>