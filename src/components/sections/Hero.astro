---
import type { ReleaseData } from "@/lib/github";
import { REPO_URL } from "@/lib/content";
import IconArrowRight from "@/components/icons/IconArrowRight.astro";
import IconGitHub from "@/components/icons/IconGitHub.astro";

interface Props {
  release: ReleaseData;
}

const { release } = Astro.props;
---

<section
  id="hero"
  data-testid="hero-section"
  class="relative isolate overflow-hidden pb-24 pt-28 sm:pt-32 md:pt-40 md:pb-32"
>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 grid-bg opacity-50" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-3xl text-center">
      <div class="reveal">
        <span class="pill pill-accent inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          v{release.version} · On-device AI workspace
        </span>
      </div>

      <h1
        class="reveal mt-6 text-balance text-4xl font-semibold leading-[1.04] tracking-tight text-fg sm:text-6xl md:text-7xl"
        style="transition-delay: 60ms;"
      >
        Your private workspace.
        <br />
        <span class="text-fg-muted">Entirely on-device.</span>
      </h1>

      <p
        class="reveal mx-auto mt-6 max-w-xl text-balance text-base leading-relaxed text-fg-muted sm:text-lg"
        style="transition-delay: 140ms;"
      >
        Kivixa is a notes, sketching, planning, and AI workspace that runs entirely on your hardware.
        No cloud sync. No accounts. Nothing leaves your device.
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-3" style="transition-delay: 220ms;">
        <a href="#download" class="btn-primary">
          Download for your device
          <IconArrowRight class="w-3.5 h-3.5" />
        </a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <IconGitHub class="w-4 h-4" />
          View on GitHub
        </a>
      </div>

      <p class="reveal mt-5 text-xs text-fg-dim" style="transition-delay: 300ms;">
        Free · MIT licensed · Windows · Android · macOS · Linux · iOS
      </p>
    </div>
  </div>
</section>