---
import IconPlatform from "@/components/icons/IconPlatform.astro";
---

<section class="border-y border-border bg-bg-elev/40">
  <div class="container-page py-8">
    <p class="text-center text-xs uppercase tracking-[0.18em] text-fg-dim reveal">
      Runs natively on every platform
    </p>
    <ul
      class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-fg-muted reveal"
    >
      <li class="flex items-center gap-2 text-sm">
        <IconPlatform platform="windows" class="w-4 h-4" />
        Windows
      </li>
      <li class="flex items-center gap-2 text-sm">
        <IconPlatform platform="android" class="w-4 h-4" />
        Android
      </li>
      <li class="flex items-center gap-2 text-sm">
        <IconPlatform platform="macos" class="w-4 h-4" />
        macOS
      </li>
      <li class="flex items-center gap-2 text-sm">
        <IconPlatform platform="linux" class="w-4 h-4" />
        Linux
      </li>
      <li class="flex items-center gap-2 text-sm">
        <IconPlatform platform="ios" class="w-4 h-4" />
        iOS
      </li>
    </ul>
  </div>
</section>