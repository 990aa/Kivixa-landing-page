---
import { models } from "@/lib/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
---

<section id="ai" data-testid="models-section" class="section">
  <div class="container-page">
    <SectionHeading
      align="center"
      overline="On-device AI"
      heading="17 models. Zero cloud. All yours."
      body="Load any of these open-weight models and run them locally. After download, Kivixa works without a network — even fully offline."
    />

    <div class="reveal mx-auto mt-14 max-w-3xl">
      <div class="overflow-hidden rounded-xl border border-border bg-[#08090b] shadow-2xl">
        <div class="flex items-center gap-2 border-b border-border/80 bg-bg-elev/60 px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[#d97770]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#c4b55f]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#6abf8b]"></span>
          <span class="ml-2 font-mono text-xs uppercase tracking-widest text-fg-dim">
            kivixa-models://local-registry
          </span>
        </div>

        <div class="h-0.5 w-full bg-bg-elev">
          <div class="h-full w-full origin-left scale-x-100 bg-gradient-to-r from-fg-muted to-fg"></div>
        </div>

        <ul class="divide-y divide-border/40 px-4 py-3 font-mono text-sm">
          {
            models.map((m) => (
              <li class="grid grid-cols-[2.4rem_1fr_auto] items-center gap-4 py-2">
                <span class="text-success">✓</span>
                <span class="text-fg">{m.name}</span>
                <span
                  class:list={[
                    "rounded-full border px-2 py-0.5 text-[0.65rem] uppercase tracking-wider",
                    m.tone === "silver" && "border-border-hi bg-bg-elev text-fg-muted",
                    m.tone === "gold" && "border-accent/30 bg-accent-soft text-accent-strong",
                    m.tone === "bright" && "border-border-hi bg-bg-elev text-fg",
                    m.tone === "muted" && "border-border bg-bg-elev text-fg-dim",
                  ]}
                >
                  {m.tag}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="border-t border-border/60 px-4 py-3 font-mono text-xs text-success">
          ✓ 17 models loaded · 0 bytes sent to cloud · GPU: Vulkan / Metal
        </div>
      </div>
    </div>
  </div>
</section>