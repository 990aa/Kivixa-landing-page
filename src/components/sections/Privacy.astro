---
import { pillars } from "@/lib/content";
import SectionHeading from "@/components/ui/SectionHeading.astro";
---

<section
  id="privacy"
  data-testid="privacy-section"
  class="section relative overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-1/2 h-[420px] w-[680px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/[0.04] blur-3xl"
    >
    </div>
  </div>

  <div class="container-page">
    <SectionHeading
      align="center"
      overline="Privacy by default"
      heading="Your data never leaves your device."
      body="No cloud sync. No accounts. No telemetry. Notes, models, vectors and history all live in your local file system — yours, encrypted, offline."
    />

    <div class="mt-14 grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:gap-10 items-center">
      <div class="reveal grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {
          pillars.map((pillar, i) => (
            <article
              class="card card-hover p-6"
              style={`transition-delay: ${i * 80}ms;`}
            >
              <h3 class="text-base font-semibold text-fg">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-fg-muted">{pillar.description}</p>
            </article>
          ))
        }
      </div>

      <div class="reveal flex items-center justify-center" style="transition-delay: 200ms;">
        <div class="relative">
          <div
            class="absolute inset-0 -z-10 rounded-full bg-fg/[0.04] blur-3xl"
            aria-hidden="true"
          >
          </div>
          <svg
            viewBox="0 0 220 230"
            width="220"
            height="230"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            class="drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)]"
          >
            <defs>
              <linearGradient id="lockShackle" x1="42" y1="16" x2="182" y2="214" gradientUnits="userSpaceOnUse">
                <stop stop-color="#e8eaed" />
                <stop offset="0.6" stop-color="#9aa0a6" />
                <stop offset="1" stop-color="#6b7280" />
              </linearGradient>
              <linearGradient id="lockBody" x1="42" y1="88" x2="182" y2="214" gradientUnits="userSpaceOnUse">
                <stop stop-color="#1f242b" />
                <stop offset="1" stop-color="#0d0f12" />
              </linearGradient>
            </defs>
            <path
              d="M62 96V66C62 38 84 16 112 16C140 16 162 38 162 66V96"
              stroke="url(#lockShackle)"
              stroke-width="14"
              stroke-linecap="round"
            />
            <rect
              x="42"
              y="88"
              width="140"
              height="126"
              rx="20"
              fill="url(#lockBody)"
              stroke="#3a4048"
              stroke-width="1.5"
            />
            <circle cx="112" cy="146" r="14" fill="#b8a882" />
            <rect x="106" y="158" width="12" height="32" rx="6" fill="#b8a882" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>